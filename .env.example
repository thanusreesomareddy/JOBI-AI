# Anthropic (plan generation + role detection + answer evaluation)
ANTHROPIC_API_KEY=

# Speech-to-text provider: browser (free, Chrome/Edge), deepgram, or openai
STT_PROVIDER=browser
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=

# Supabase (service role — backend only, never expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-6
PLAN_DAYS_DEFAULT=7
UPLOAD_DIR=uploads
